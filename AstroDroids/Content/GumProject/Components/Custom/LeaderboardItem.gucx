<?xml version="1.0" encoding="utf-8"?>
<ComponentSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Name>Custom/LeaderboardItem</Name>
  <BaseType>Container</BaseType>
  <State>
    <Name>Default</Name>
    <Variable Type="float" Name="Height" SetsValue="true">
      <Value xsi:type="xsd:float">26</Value>
    </Variable>
    <Variable Type="float" Name="NameLabel.DropshadowBlur" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="float" Name="NameLabel.DropshadowOffsetX" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="float" Name="NameLabel.DropshadowOffsetY" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="bool" Name="NameLabel.HasDropshadow" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="bool" Name="NameLabel.IsBold" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="string" Name="NameLabel.Text" SetsValue="true">
      <Value xsi:type="xsd:string">Name</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="NameLabel.VerticalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="NameLabel.X" SetsValue="true">
      <Value xsi:type="xsd:float">25</Value>
    </Variable>
    <Variable Type="float" Name="NameLabel.Y" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="NameLabel.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="NameLabel.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="float" Name="PlaceLabel.DropshadowBlur" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="float" Name="PlaceLabel.DropshadowOffsetX" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="float" Name="PlaceLabel.DropshadowOffsetY" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="bool" Name="PlaceLabel.HasDropshadow" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="bool" Name="PlaceLabel.IsBold" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="string" Name="PlaceLabel.Text" SetsValue="true">
      <Value xsi:type="xsd:string">1</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="PlaceLabel.VerticalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="float" Name="PlaceLabel.Y" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="PlaceLabel.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="PlaceLabel.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="float" Name="ScoreLabel.DropshadowBlur" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="float" Name="ScoreLabel.DropshadowOffsetX" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="float" Name="ScoreLabel.DropshadowOffsetY" SetsValue="true">
      <Value xsi:type="xsd:float">2</Value>
    </Variable>
    <Variable Type="bool" Name="ScoreLabel.HasDropshadow" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="bool" Name="ScoreLabel.IsBold" SetsValue="true">
      <Value xsi:type="xsd:boolean">true</Value>
    </Variable>
    <Variable Type="string" Name="ScoreLabel.Text" SetsValue="true">
      <Value xsi:type="xsd:string">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="ScoreLabel.VerticalAlignment" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="HorizontalAlignment" Name="ScoreLabel.XOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">2</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="ScoreLabel.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">4</Value>
    </Variable>
    <Variable Type="float" Name="ScoreLabel.Y" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
    <Variable Type="VerticalAlignment" Name="ScoreLabel.YOrigin" SetsValue="true">
      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="ScoreLabel.YUnits" SetsValue="true">
      <Value xsi:type="xsd:int">7</Value>
    </Variable>
    <Variable Type="SlideCategory" Name="SlideCategoryState" SetsValue="true" />
    <Variable Type="State" Name="State" Category="States and Visibility" SetsValue="false">
      <Value xsi:type="xsd:string">Default</Value>
    </Variable>
    <Variable Type="float" Name="Width" SetsValue="true">
      <Value xsi:type="xsd:float">250</Value>
    </Variable>
  </State>
  <Category>
    <Name>SlideCategory</Name>
    <State>
      <Name>In</Name>
      <Variable Type="float" Name="X" Category="Position" SetsValue="true">
        <Value xsi:type="xsd:float">0</Value>
      </Variable>
    </State>
    <State>
      <Name>Out</Name>
      <Variable Type="float" Name="X" SetsValue="true">
        <Value xsi:type="xsd:float">-600</Value>
      </Variable>
    </State>
    <State>
      <Name>OutRight</Name>
      <Variable Type="float" Name="X" Category="Position" SetsValue="true">
        <Value xsi:type="xsd:float">600</Value>
      </Variable>
    </State>
  </Category>
  <Instance Name="NameLabel" BaseType="Text" />
  <Instance Name="PlaceLabel" BaseType="Text" />
  <Instance Name="ScoreLabel" BaseType="Text" />
  <Behaviors />
</ComponentSave>