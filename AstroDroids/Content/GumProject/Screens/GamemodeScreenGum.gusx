    </Variable>
    <Variable Type="float" Name="BossRushBtn.Y" SetsValue="true">
      <Value xsi:type="xsd:float">45</Value>
    </Variable>
    <Variable Type="string" Name="ReturnBtn.Text" SetsValue="true">
      <Value xsi:type="xsd:string">T_Return</Value>
    </Variable>
    <Variable Type="float" Name="ReturnBtn.X" SetsValue="true">
      <Value xsi:type="xsd:float">0</Value>
    </Variable>
