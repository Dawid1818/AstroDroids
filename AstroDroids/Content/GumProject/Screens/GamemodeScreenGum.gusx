      <Value xsi:type="xsd:int">1</Value>
    </Variable>
    <Variable Type="PositionUnitType" Name="ReturnBtn.XUnits" SetsValue="true">
      <Value xsi:type="xsd:int">6</Value>
    </Variable>
    <Variable Type="float" Name="ReturnBtn.Y" SetsValue="true">
      <Value xsi:type="xsd:float">490</Value>
    </Variable>
    <Variable Type="float" Name="StoryBtn.Height" SetsValue="true">
      <Value xsi:type="xsd:float">414</Value>
    </Variable>
    <Variable Type="string" Name="StoryBtn.Text" SetsValue="true">
      <Value xsi:type="xsd:string">T_StoryMode</Value>
    </Variable>
    <Variable Type="float" Name="StoryBtn.Width" SetsValue="true">
      <Value xsi:type="xsd:float">211</Value>
    </Variable>
    <Variable Type="float" Name="StoryBtn.X" SetsValue="true">
      <Value xsi:type="xsd:float">296</Value>
    </Variable>
    <Variable Type="float" Name="StoryBtn.Y" SetsValue="true">
      <Value xsi:type="xsd:float">45</Value>
    </Variable>
    <Variable IsFile="true" Type="string" Name="TutorialBtn.BannerImage" SetsValue="true">
