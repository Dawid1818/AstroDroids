      <Value xsi:type="xsd:float">211</Value>
    </Variable>
    <Variable Type="float" Name="TutorialBtn.X" SetsValue="true">
      <Value xsi:type="xsd:float">31</Value>
    </Variable>
    <Variable Type="float" Name="TutorialBtn.Y" SetsValue="true">
      <Value xsi:type="xsd:float">45</Value>
    </Variable>
  </State>
  <Instance Name="ReturnBtn" BaseType="Controls/ButtonGlow" />
  <Instance Name="TutorialBtn" BaseType="Controls/ButtonGlowGameMode" />
