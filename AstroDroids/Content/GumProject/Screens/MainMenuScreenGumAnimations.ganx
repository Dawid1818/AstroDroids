<?xml version="1.0" encoding="utf-8"?>
<ElementAnimationsSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Animations>
    <AnimationSave>
      <Loops>false</Loops>
      <Name>Enter</Name>
      <States>
        <AnimatedStateSave>
          <StateName>Animations/PlayArrival</StateName>
          <Time>0</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
        <AnimatedStateSave>
          <StateName>Animations/Arrived</StateName>
          <Time>1</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
      </States>
      <Animations>
        <AnimationReferenceSave>
          <Name>PlayBtn.SlideIn</Name>
          <Time>0</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CustomizeBtn.SlideIn</Name>
          <Time>0.1</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>SettingsBtn.SlideIn</Name>
          <Time>0.2</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>LeaderboardBtn.SlideIn</Name>
          <Time>0.3</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CreditsBtn.SlideIn</Name>
          <Time>0.4</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>ExitBtn.SlideIn</Name>
          <Time>0.5</Time>
        </AnimationReferenceSave>
      </Animations>
      <Events />
    </AnimationSave>
    <AnimationSave>
      <Loops>false</Loops>
      <Name>Leave</Name>
      <States>
        <AnimatedStateSave>
          <StateName>Animations/Arrived</StateName>
          <Time>0</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
        <AnimatedStateSave>
          <StateName>Animations/PlayArrival</StateName>
          <Time>1</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
      </States>
      <Animations>
        <AnimationReferenceSave>
          <Name>PlayBtn.SlideOut</Name>
          <Time>0</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CustomizeBtn.SlideOut</Name>
          <Time>0.1</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>SettingsBtn.SlideOut</Name>
          <Time>0.2</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>LeaderboardBtn.SlideOut</Name>
          <Time>0.3</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CreditsBtn.SlideOut</Name>
          <Time>0.4</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>ExitBtn.SlideOut</Name>
          <Time>0.5</Time>
        </AnimationReferenceSave>
      </Animations>
      <Events />
    </AnimationSave>
    <AnimationSave>
      <Loops>false</Loops>
      <Name>EnterSimple</Name>
      <States />
      <Animations />
      <Events />
    </AnimationSave>
  </Animations>
</ElementAnimationsSave>