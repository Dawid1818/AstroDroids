<?xml version="1.0" encoding="utf-8"?>
<ElementAnimationsSave xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <Animations>
    <AnimationSave>
      <Loops>false</Loops>
      <Name>Enter</Name>
      <States>
        <AnimatedStateSave>
          <StateName>ColorPickerCategory/Out</StateName>
          <Time>0</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
        <AnimatedStateSave>
          <StateName>ColorPickerCategory/In</StateName>
          <Time>1</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
      </States>
      <Animations>
        <AnimationReferenceSave>
          <Name>BodyBtn.SlideInShort</Name>
          <Time>0</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>WeaponsBtn.SlideInShort</Name>
          <Time>0.1</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>EnginesBtn.SlideInShort</Name>
          <Time>0.2</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CockpitBtn.SlideInShort</Name>
          <Time>0.3</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CockpitGlassBtn.SlideInShort</Name>
          <Time>0.4</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>WingsBtn.SlideInShort</Name>
          <Time>0.5</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>ReturnBtn.SlideInShort</Name>
          <Time>0.6</Time>
        </AnimationReferenceSave>
      </Animations>
      <Events />
    </AnimationSave>
    <AnimationSave>
      <Loops>false</Loops>
      <Name>Leave</Name>
      <States>
        <AnimatedStateSave>
          <StateName>ColorPickerCategory/In</StateName>
          <Time>0</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
        <AnimatedStateSave>
          <StateName>ColorPickerCategory/Out</StateName>
          <Time>1</Time>
          <InterpolationType>Linear</InterpolationType>
          <Easing>Out</Easing>
        </AnimatedStateSave>
      </States>
      <Animations>
        <AnimationReferenceSave>
          <Name>BodyBtn.SlideOutLeftShort</Name>
          <Time>0</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>WeaponsBtn.SlideOutLeftShort</Name>
          <Time>0.1</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>EnginesBtn.SlideOutLeftShort</Name>
          <Time>0.2</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CockpitBtn.SlideOutLeftShort</Name>
          <Time>0.3</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>CockpitGlassBtn.SlideOutLeftShort</Name>
          <Time>0.4</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>WingsBtn.SlideOutLeftShort</Name>
          <Time>0.5</Time>
        </AnimationReferenceSave>
        <AnimationReferenceSave>
          <Name>ReturnBtn.SlideOutLeftShort</Name>
          <Time>0.6</Time>
        </AnimationReferenceSave>
      </Animations>
      <Events />
    </AnimationSave>
  </Animations>
</ElementAnimationsSave>